<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:carton.GUI.Controls"
             xmlns:vm="using:carton.ViewModels"
             x:Class="carton.Views.Pages.LogsView"
             x:DataType="vm:LogsViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="20">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,10">
      <TextBox Classes="pageSearch" Text="{Binding SearchText}"
               PlaceholderText="{DynamicResource Logs.Search.Watermark}"
               AutomationProperties.Name="{DynamicResource Logs.Search.Watermark}">
        <TextBox.InnerLeftContent>
          <PathIcon Classes="searchGlyph" Data="M10 2A8 8 0 1 0 15 16.25L20.75 22L22 20.75L16.25 15A8 8 0 0 0 10 2Z M10 4A6 6 0 1 1 10 16A6 6 0 1 1 10 4Z"/>
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="1" Classes="pageAction" Command="{Binding CopySelectedLogCommand}"
              ToolTip.Tip="{DynamicResource Logs.Button.CopySelected}" AutomationProperties.Name="{DynamicResource Logs.Button.CopySelected}">
        <PathIcon Width="16" Height="16" Data="M7 2H20V17H18V4H7Z M3 6H16V22H3Z M5 8V20H14V8Z"/>
      </Button>
      <Button Grid.Column="2" Classes="pageAction" Command="{Binding CopyAllLogsCommand}"
              ToolTip.Tip="{DynamicResource Logs.Button.CopyAll}" AutomationProperties.Name="{DynamicResource Logs.Button.CopyAll}">
        <PathIcon Width="16" Height="16" Data="M7 2H21V18H19V4H7Z M3 6H17V22H3Z M5 8V20H15V8Z M7 10H13V12H7Z M7 14H13V16H7Z"/>
      </Button>
      <Button Grid.Column="3" Classes="pageAction" Command="{Binding ClearLogsCommand}"
              ToolTip.Tip="{DynamicResource Logs.Button.Clear}" AutomationProperties.Name="{DynamicResource Logs.Button.Clear}">
        <PathIcon Width="16" Height="16" Data="{StaticResource DeleteIconGeometry}"/>
      </Button>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12" ColumnSpacing="8">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
        <ComboBox Width="80" Height="40" VerticalAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedLevel}"/>
        <ComboBox Width="90" Height="40" VerticalAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{Binding LogSourceFilters}" SelectedItem="{Binding SelectedSourceFilter}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:LogSourceFilterOptionViewModel"><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Orientation="Horizontal" Spacing="6" Height="40" VerticalAlignment="Center">
          <ToggleSwitch VerticalAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding IsAutoScrollToLatest}" ToolTip.Tip="{DynamicResource Logs.CheckBox.AutoScrollToLatest}"
                        AutomationProperties.Name="{DynamicResource Logs.CheckBox.AutoScrollToLatest}"/>
          <TextBlock Text="{DynamicResource Logs.CheckBox.AutoScrollToLatest}" FontSize="14" VerticalAlignment="Center"
                     Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
        </StackPanel>
      </WrapPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}">
        <Run Text="{DynamicResource Logs.Label.CountPrefix}"/><Run Text=" "/><Run Text="{Binding Logs.Count}"/>
      </TextBlock>
    </Grid>
    <Border Grid.Row="2" Classes="card" ClipToBounds="True" Padding="8">
      <ListBox x:Name="LogsListBox" ItemsSource="{Binding Logs}" SelectionMode="Multiple"
               SelectedItem="{Binding SelectedLog}" Background="Transparent" BorderThickness="0">
        <ListBox.KeyBindings><KeyBinding Gesture="Ctrl+C" Command="{Binding CopySelectedLogCommand}"/></ListBox.KeyBindings>
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate DataType="vm:LogEntryViewModel"><controls:LogRowControl HorizontalAlignment="Stretch"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>

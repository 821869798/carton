<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:carton.Controls"
             xmlns:vm="using:carton.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="carton.Views.Pages.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <UserControl.Resources>
    <StreamGeometry x:Key="DashboardWebUiIconData">M12 3 C7 3 3 7 3 12 C3 17 7 21 12 21 C17 21 21 17 21 12 C21 7 17 3 12 3 Z M5.2 11 H8.1 C8.2 8.7 8.8 6.7 9.8 5.2 C7.5 6 5.8 8.2 5.2 11 Z M5.2 13 C5.8 15.8 7.5 18 9.8 18.8 C8.8 17.3 8.2 15.3 8.1 13 Z M10.1 13 C10.2 15.6 11 17.8 12 18.9 C13 17.8 13.8 15.6 13.9 13 Z M13.9 11 C13.8 8.4 13 6.2 12 5.1 C11 6.2 10.2 8.4 10.1 11 Z M14.2 18.8 C16.5 18 18.2 15.8 18.8 13 H15.9 C15.8 15.3 15.2 17.3 14.2 18.8 Z M15.9 11 H18.8 C18.2 8.2 16.5 6 14.2 5.2 C15.2 6.7 15.8 8.7 15.9 11 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.sfmCard">
      <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <Style Selector="Border.sfmCard.compact">
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Border.modeTrack">
      <Setter Property="Background" Value="{DynamicResource CartonControlBackgroundBaseLowBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="4"/>
    </Style>

    <Style Selector="Button.iconButton">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CartonControlForegroundBaseMediumLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
    </Style>

    <Style Selector="Button.iconButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource CartonControlBackgroundBaseLowBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CartonControlForegroundBaseHighBrush}"/>
    </Style>

    <Style Selector="Button.iconButton:pressed">
      <Setter Property="Background" Value="{DynamicResource CartonControlBackgroundChromeMediumBrush}"/>
    </Style>

    <Style Selector="Border.portScopeTrack">
      <Setter Property="Background" Value="{DynamicResource CartonControlBackgroundBaseLowBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="RadioButton.portScopeSegment">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="MinWidth" Value="64"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="RadioButton.portScopeSegment:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource CartonControlForegroundBaseHighBrush}"/>
    </Style>

    <Style Selector="RadioButton.portScopeSegment:checked">
      <Setter Property="Background" Value="{DynamicResource CartonControlBackgroundChromeMediumBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CartonControlForegroundBaseHighBrush}"/>
    </Style>

    <Style Selector="RadioButton.portScopeSegment:disabled">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="RadioButton.modeSegment">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="RadioButton.modeSegment:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource CartonControlForegroundBaseHighBrush}"/>
    </Style>

    <Style Selector="RadioButton.modeSegment:checked">
      <Setter Property="Background" Value="{DynamicResource CartonControlBackgroundChromeMediumBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CartonControlForegroundBaseHighBrush}"/>
    </Style>

    <Style Selector="ComboBox.modeDropdown /template/ Popup#PART_Popup">
      <Setter Property="Placement" Value="TopEdgeAlignedLeft"/>
    </Style>

  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="16">
      <!-- 左右两张配置卡片，样式与上传/下载状态卡片一致；不再有内嵌的画线框。
           列宽沿用原先的 *,180，右侧开关卡片不需要更多空间；
           两张卡片 VerticalAlignment=Top，各撑各的高度，不被拉平成一样高。 -->
      <Grid ColumnDefinitions="*,180" ColumnSpacing="16"
            IsEnabled="{Binding CanUseDashboardControls}">
        <Border Grid.Column="0"
                Classes="card sfmCard"
                Padding="12"
                VerticalAlignment="Top">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          Spacing="10"
                          VerticalAlignment="Center">
                <PathIcon Width="16"
                          Height="16"
                          Data="M6 2 H14 L19 8 V22 H6 Z"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Dashboard.Section.Configuration}"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="iconButton"
                      Command="{Binding ResetRuntimeOptionsToConfigCommand}"
                      IsEnabled="{Binding ShowStartupSelector}"
                      ToolTip.Tip="{DynamicResource Dashboard.Button.ResetToConfig}">
                <PathIcon Width="14"
                          Height="14"
                          Data="M12 5 V1 L7 6 L12 11 V7 C15.3 7 18 9.7 18 13 C18 16.3 15.3 19 12 19 C8.7 19 6 16.3 6 13 H4 C4 17.4 7.6 21 12 21 C16.4 21 20 17.4 20 13 C20 8.6 16.4 5 12 5 Z"/>
              </Button>
            </Grid>

            <WrapPanel Orientation="Horizontal">
              <StackPanel Orientation="Horizontal"
                          Spacing="10"
                          Margin="0,0,10,6">
                <TextBlock Text="{DynamicResource Dashboard.Field.Port}"
                           Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding InboundPortText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Classes="iconButton"
                        Command="{Binding EditInboundPortCommand}"
                        IsEnabled="{Binding ShowStartupSelector}"
                        ToolTip.Tip="{DynamicResource Dashboard.Port.Edit}">
                  <PathIcon Width="14"
                            Height="14"
                            Data="M4 16.5 V20 H7.5 L17.8 9.7 L14.3 6.2 Z M19 8.5 L20.5 7 C21.1 6.4 21.1 5.4 20.5 4.8 L19.2 3.5 C18.6 2.9 17.6 2.9 17 3.5 L15.5 5 Z"/>
                </Button>
              </StackPanel>

              <Border Classes="portScopeTrack"
                      Margin="0,0,10,6">
                <Grid ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="3">
                  <RadioButton Grid.Column="0"
                               Classes="portScopeSegment"
                               Content="{DynamicResource Dashboard.Port.Scope.LocalOnly}"
                               GroupName="port-scope"
                               IsChecked="{Binding IsLocalOnlySelected, Mode=OneWay}"
                               Command="{Binding SelectLocalOnlyCommand}"
                               IsEnabled="{Binding ShowStartupSelector}"
                               ToolTip.Tip="{Binding LocalOnlyAccessToolTip}"/>
                  <RadioButton Grid.Column="1"
                               Classes="portScopeSegment"
                               Content="{DynamicResource Dashboard.Port.Scope.Lan}"
                               GroupName="port-scope"
                               IsChecked="{Binding IsLanAccessSelected, Mode=OneWay}"
                               Command="{Binding SelectLanAccessCommand}"
                               IsEnabled="{Binding ShowStartupSelector}"
                               ToolTip.Tip="{Binding LanAccessToolTip}"/>
                </Grid>
              </Border>

              <StackPanel Orientation="Horizontal"
                          Spacing="10"
                          Margin="0,0,0,6">
                <Button Classes="iconButton"
                        IsEnabled="{Binding ShowDashboardMetrics}"
                        ToolTip.Tip="{DynamicResource Dashboard.Menu.OpenTool}">
                  <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                      <MenuItem Header="{DynamicResource Dashboard.Menu.OpenCmd}"
                                Command="{Binding OpenCmdTerminalProxyCommand}"
                                IsVisible="{Binding IsWindows}"/>
                      <MenuItem Header="{DynamicResource Dashboard.Menu.OpenPs}"
                                Command="{Binding OpenPsTerminalProxyCommand}"
                                IsVisible="{Binding IsWindows}"/>
                      <MenuItem Header="{DynamicResource Dashboard.Button.CopyCmdProxy}"
                                Command="{Binding CopyCmdTerminalProxyCommand}"
                                IsVisible="{Binding IsWindows}"/>
                      <MenuItem Header="{DynamicResource Dashboard.Button.CopyPsProxy}"
                                Command="{Binding CopyPsTerminalProxyCommand}"
                                IsVisible="{Binding IsWindows}"/>
                      <MenuItem Header="{DynamicResource Dashboard.Button.CopyLinuxProxy}"
                                Command="{Binding CopyLinuxTerminalProxyCommand}"
                                IsVisible="{Binding IsLinux}"/>
                    </MenuFlyout>
                  </Button.Flyout>
                  <PathIcon Width="14"
                            Height="14"
                            Data="M3 6 H21 V18 H3 Z M6.5 10 L9.5 12 L6.5 14 M11.5 14 H16.5"/>
                </Button>
                <Button Classes="iconButton"
                        Command="{Binding OpenSingBoxWebUiCommand}"
                        IsEnabled="{Binding CanOpenSingBoxWebUi}"
                        ToolTip.Tip="{DynamicResource Dashboard.Button.OpenWebUi}">
                  <PathIcon Width="14"
                            Height="14"
                            Data="{StaticResource DashboardWebUiIconData}"/>
                </Button>
              </StackPanel>
            </WrapPanel>

            <Grid ColumnDefinitions="Auto,120,*" ColumnSpacing="10">
              <TextBlock Grid.Column="0"
                         Text="{DynamicResource Dashboard.Field.LogLevel}"
                         Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"
                         VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding LogLevelOptions}"
                        SelectedItem="{Binding SelectedLogLevel}"
                        Width="120"
                        IsEnabled="{Binding ShowStartupSelector}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2"
                         Text="{DynamicResource Dashboard.LogLevel.HighVolumeHint}"
                         IsVisible="{Binding ShowVerboseLogLevelHint}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Classes="card sfmCard"
                Padding="12"
                VerticalAlignment="Top">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Width="16"
                        Height="16"
                        Data="M5 9 H19 V15 H5 Z M14 10.5 H17.5 V13.5 H14 Z"
                        VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Dashboard.Section.Switches}"
                         FontSize="16"
                         FontWeight="Bold"
                         VerticalAlignment="Center"/>
            </StackPanel>

            <Grid MinHeight="32" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{DynamicResource Dashboard.Option.SystemProxy}"
                         VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding EnableSystemProxy}"/>
            </Grid>

            <Grid MinHeight="32" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{DynamicResource Dashboard.Option.Tun}"
                         VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding EnableTunInbound}"
                            IsEnabled="{Binding CanToggleTunInbound}"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 配置列表独立成卡片。ListBox 自带虚拟化，且不再每行一个 RadioButton（Fluent 模板很重）。
           内核 Starting/Stopping 期间禁用：选择只在 Stopped|Error 才落盘，此时放行会让界面
           显示一个内核并没有在用的配置（看起来换了、实际没换）。 -->
      <Border Classes="card sfmCard" Padding="12"
              IsVisible="{Binding ShowStartupSelector}"
              IsEnabled="{Binding CanUseDashboardControls}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Width="16"
                      Height="16"
                      Data="M4 6 H20 V8 H4 Z M4 11 H20 V13 H4 Z M4 16 H20 V18 H4 Z"
                      VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Dashboard.Section.StartupProfile}"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <ListBox ItemsSource="{Binding AvailableProfiles}"
                   SelectedItem="{Binding SelectedStartupProfile, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   MaxHeight="240"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:DashboardProfileItemViewModel">
                <TextBlock Text="{Binding Name}"
                           FontSize="16"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="{Binding StartupStatus}"
                     IsVisible="{Binding StartupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
        </StackPanel>
      </Border>

      <ContentControl Content="{Binding DashboardMetricsContent}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:DashboardViewModel">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <Border Classes="card sfmCard" Padding="12" Height="164">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <PathIcon Width="16"
                                    Height="16"
                                    Data="M12 3 L17 10 H14 V21 H10 V10 H7 Z"
                                    VerticalAlignment="Center"/>
                          <TextBlock Text="{DynamicResource Dashboard.Label.UploadSpeed}"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding UploadSpeed}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                      </Grid>

                      <TextBlock Text="{Binding TotalUpload}"
                                 FontSize="12"
                                 Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>

                      <controls:SparklineChart Height="56"
                                               Samples="{Binding UploadTrafficSamples}"
                                               GridBrush="{DynamicResource CartonControlForegroundBaseMediumLowBrush}"
                                               FillBrush="{DynamicResource CartonAccentBrush}"
                                               LineBrush="{DynamicResource CartonAccentBrush}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Classes="card sfmCard" Padding="12" Height="164">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <PathIcon Width="16"
                                    Height="16"
                                    Data="M12 21 L7 14 H10 V3 H14 V14 H17 Z"
                                    VerticalAlignment="Center"/>
                          <TextBlock Text="{DynamicResource Dashboard.Label.DownloadSpeed}"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DownloadSpeed}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                      </Grid>

                      <TextBlock Text="{Binding TotalDownload}"
                                 FontSize="12"
                                 Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>

                      <controls:SparklineChart Height="56"
                                               Samples="{Binding DownloadTrafficSamples}"
                                               GridBrush="{DynamicResource CartonControlForegroundBaseMediumLowBrush}"
                                               FillBrush="{DynamicResource CartonAccentBrush}"
                                               LineBrush="{DynamicResource CartonAccentBrush}"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                  <Border Classes="card sfmCard compact" Padding="12" Height="98">
                    <Grid RowDefinitions="*,*,*">
                      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PathIcon Width="15"
                                  Height="15"
                                  Data="M3 6 H21 V18 H3 Z M7 10 H17 V14 H7 Z"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dashboard.KernelStatus.TitleShort}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                      </StackPanel>

                      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard.KernelMemory.MemoryUsage}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MemoryUsage}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                      </Grid>

                      <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard.KernelStatus.Goroutines}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding GoroutineCount}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1" Classes="card sfmCard compact" Padding="12" Height="98">
                    <Grid RowDefinitions="*,*,*">
                      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PathIcon Width="15"
                                  Height="15"
                                  Data="M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dashboard.Connections.Title}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                      </StackPanel>

                      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard.Connections.Inbound}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ConnectionsIn}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                      </Grid>

                      <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Dashboard.Connections.Outbound}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ConnectionsOut}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                      </Grid>
                    </Grid>
                  </Border>

                  <Border Grid.Column="2" Classes="card sfmCard compact" Padding="12" Height="98">
                    <Grid RowDefinitions="*,*,*">
                      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <PathIcon Grid.Column="0"
                                  Width="15"
                                  Height="15"
                                  Data="M13 2 L5 13 H11 L9 22 L19 9 H13 Z"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource Dashboard.Connectivity.TitleShort}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Classes="iconButton"
                                Width="24"
                                Height="24"
                                CornerRadius="12"
                                Command="{Binding RefreshConnectivityCommand}"
                                IsEnabled="{Binding !IsRefreshingConnectivity}"
                                ToolTip.Tip="{DynamicResource Dashboard.KernelStatus.Refresh}">
                          <PathIcon Width="12"
                                    Height="12"
                                    Data="M13 2 L5 13 H11 L9 22 L19 9 H13 Z"/>
                        </Button>
                      </Grid>

                      <ItemsControl Grid.Row="1" Grid.RowSpan="2" ItemsSource="{Binding ConnectivityItems}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="2"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:DashboardSiteStatusItemViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding LatencyText}"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         Foreground="{Binding Latency, Converter={StaticResource LatencyForegroundConverter}}"
                                         HorizontalAlignment="Right"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </Grid>

                <Border Classes="card sfmCard" Padding="12">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Width="15"
                                Height="15"
                                Data="M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z"
                                VerticalAlignment="Center"/>
                      <TextBlock Text="{DynamicResource Dashboard.ProxyMode}"
                                 FontSize="15"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Classes="modeTrack"
                            IsVisible="{Binding ShowModeSegments}">
                      <ItemsControl ItemsSource="{Binding ModeOptions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1"
                                         Columns="{Binding ModeColumnCount}"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:DashboardModeOptionViewModel">
                            <RadioButton Classes="modeSegment"
                                         Content="{Binding DisplayName}"
                                         GroupName="outbound-mode"
                                         IsChecked="{Binding IsSelected}"
                                         Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).ChangeModeCommand}"
                                         CommandParameter="{Binding}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>

                    <ComboBox Classes="modeDropdown"
                              ItemsSource="{Binding ModeOptions}"
                              SelectedItem="{Binding SelectedModeOption}"
                              IsVisible="{Binding UseModeDropdown}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:DashboardModeOptionViewModel">
                          <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Border>
            </StackPanel>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>

</UserControl>

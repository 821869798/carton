<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:carton.ViewModels"
             xmlns:controls="using:carton.GUI.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="carton.Views.Pages.ProfilesView"
             x:DataType="vm:ProfilesViewModel">

  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.iconButton.saveButton">
      <Setter Property="Foreground" Value="{DynamicResource CartonControlForegroundBaseMediumLowBrush}"/>
    </Style>
    <Style Selector="Button.iconButton.saveButton:enabled">
      <Setter Property="Background" Value="{DynamicResource CartonAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CartonAccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CartonAccentForegroundBrush}"/>
    </Style>
    <Style Selector="Button.iconButton.saveButton:enabled:pointerover">
      <Setter Property="Background" Value="{DynamicResource CartonAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CartonAccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CartonAccentForegroundBrush}"/>
    </Style>
    <Style Selector="Button.iconButton.saveButton:enabled:pressed">
      <Setter Property="Background" Value="{DynamicResource CartonAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CartonAccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CartonAccentForegroundBrush}"/>
      <Setter Property="Opacity" Value="0.88"/>
    </Style>
    <Style Selector="Button.searchChip">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style Selector="Border.profileCard">
      <Setter Property="Background" Value="{DynamicResource CartonSettingsItemBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CartonSettingsItemBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style Selector="Border.profileCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource CartonSettingsItemPointerOverBackgroundBrush}"/>
    </Style>

    <Style Selector="Button.profileEditArea">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"/>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- Back, title and editor actions share one unboxed header. -->
    <Border Grid.Row="0"
            IsVisible="{Binding IsProfileFormMode}"
            Margin="20,20,20,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Button Grid.Column="0"
                Classes="iconButton"
                Command="{Binding GoBackCommand}"
                IsVisible="{Binding IsProfileFormMode}"
                ToolTip.Tip="{DynamicResource Profiles.Button.Back}">
          <PathIcon Width="14" Height="14"
                    Data="{StaticResource BackIconGeometry}"/>
        </Button>
        <Grid Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding ProfileFormTitle}" FontSize="16" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" IsVisible="{Binding !ShowConfigFullscreenView}"/>
          <TextBlock Text="{DynamicResource Profiles.Form.Content.Show}" FontSize="16" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowConfigFullscreenView}"/>
        </Grid>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    IsVisible="{Binding ShowConfigFullscreenView}">
          <Button x:Name="SearchConfigButton"
                  Classes="iconButton"
                  Click="OnSearchConfigClick"
                  ToolTip.Tip="{DynamicResource Profiles.Editor.Search}">
            <PathIcon Width="14" Height="14"
                      Data="{StaticResource SearchIconGeometry}"/>
          </Button>
          <Button Classes="iconButton"
                  Command="{Binding ValidateConfigJsonCommand}"
                  ToolTip.Tip="{Binding ValidateJsonText}">
            <PathIcon Width="14" Height="14"
                      Data="{StaticResource CheckIconGeometry}"/>
          </Button>
          <Button Classes="iconButton"
                  Command="{Binding FormatConfigJsonCommand}"
                  ToolTip.Tip="{Binding FormatJsonText}">
            <PathIcon Width="14" Height="14"
                      Data="{StaticResource FormatIconGeometry}"/>
          </Button>
          <Button Classes="iconButton saveButton"
                  Command="{Binding SaveProfileInEditorCommand}"
                  IsEnabled="{Binding CanSaveConfigInEditor}"
                  IsVisible="{Binding CanEditContent}"
                  ToolTip.Tip="{DynamicResource Profiles.Form.SaveButton}">
            <PathIcon Width="14" Height="14"
                      Data="{StaticResource SaveIconGeometry}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Config Search Bar -->
    <Border Grid.Row="1"
            x:Name="ConfigSearchBar"
            IsVisible="False"
            Background="Transparent"
            Margin="20,12,20,0"
            Padding="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
        <TextBox x:Name="ConfigSearchInput"
                 Grid.Column="0"
                 Classes="pageSearch"
                 VerticalAlignment="Center"
                 PlaceholderText="{DynamicResource Profiles.Editor.Search}"/>
        <TextBlock x:Name="ConfigSearchStatus"
                   Grid.Column="1"
                   Width="56"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>
        <Button x:Name="ConfigSearchCaseButton"
                Grid.Column="2"
                Classes="searchChip"
                Content="Aa"
                Click="OnSearchCaseClick"/>
        <Button x:Name="ConfigSearchWholeWordButton"
                Grid.Column="3"
                Classes="searchChip"
                Content="W"
                Click="OnSearchWholeWordClick"/>
        <Button x:Name="ConfigSearchRegexButton"
                Grid.Column="4"
                Classes="searchChip"
                Content=".*"
                Click="OnSearchRegexClick"/>
        <Button x:Name="ConfigSearchPreviousButton"
                Grid.Column="5"
                Classes="iconButton"
                Click="OnSearchPreviousClick">
          <PathIcon Width="14" Height="14"
                    Data="{StaticResource PreviousIconGeometry}"/>
        </Button>
        <Button x:Name="ConfigSearchNextButton"
                Grid.Column="6"
                Classes="iconButton"
                Click="OnSearchNextClick">
          <PathIcon Width="14" Height="14"
                    Data="{StaticResource NextIconGeometry}"/>
        </Button>
        <Button x:Name="ConfigSearchCloseButton"
                Grid.Column="7"
                Classes="iconButton"
                Click="OnSearchCloseClick">
          <PathIcon Width="14" Height="14"
                    Data="{StaticResource CloseIconGeometry}"/>
        </Button>
      </Grid>
    </Border>

    <!-- Import Status Bar -->
    <Border Grid.Row="2"
            IsVisible="{Binding ImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="{DynamicResource CartonControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource CartonControlForegroundBaseMediumLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsImporting}" Width="80" Height="4"/>
        <TextBlock Text="{Binding ImportStatus}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Main Content -->
    <Grid Grid.Row="3">
      <!-- Profile List View -->
      <ScrollViewer Classes="smooth" IsVisible="{Binding !IsProfileFormMode}">
        <StackPanel Margin="20" Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <Button Grid.Column="1"
                    Classes="accent"
                    Command="{Binding ShowCreateProfileDialogCommand}"
                    ToolTip.Tip="{DynamicResource Profiles.Button.NewProfile}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="12" Height="12"
                          Data="{StaticResource AddIconGeometry}"/>
                <TextBlock Text="{DynamicResource Profiles.Button.NewProfile}"/>
              </StackPanel>
            </Button>
          </Grid>

          <ItemsControl x:Name="ProfilesList" ItemsSource="{Binding Profiles}" KeyDown="OnProfileListKeyDown">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="profileCard">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <!-- Clickable area: icon + info -->
                    <Button Grid.Column="0"
                            Classes="profileEditArea"
                            Command="{Binding $parent[ItemsControl].((vm:ProfilesViewModel)DataContext).EditProfileCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <!-- Type Icon -->
                        <Border Grid.Column="0"
                                Width="40" Height="40"
                                CornerRadius="20"
                                Background="{DynamicResource CartonControlBackgroundBaseLowBrush}"
                                VerticalAlignment="Center">
                          <PathIcon Width="18" Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"
                                    Data="M13.99 3.09V2H5.99L3.99 4V17C3.99 18.1 4.89 19 5.99 19H17.99C19.09 19 19.99 18.1 19.99 17V8L13.99 3.09ZM11.99 4.5L16.49 9H11.99V4.5ZM6.99 17V15H9.99V17H6.99ZM11.99 17V12H16.99V17H11.99Z"/>
                        </Border>

                        <!-- Profile Info -->
                        <StackPanel Grid.Column="1"
                                    Spacing="3"
                                    VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Classes="fluentBadge"
                                    VerticalAlignment="Center">
                              <TextBlock Classes="fluentBadgeText"
                                         Text="{Binding Type}"/>
                            </Border>
                          </StackPanel>
                          <TextBlock FontSize="12"
                                     Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}">
                            <Run Text="{DynamicResource Profiles.List.LastUpdatedLabel}"/>
                            <Run Text="{Binding LastUpdated}"/>
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                    </Button>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <Button Classes="iconButton"
                              Command="{Binding $parent[ItemsControl].((vm:ProfilesViewModel)DataContext).UpdateProfileCommand}"
                              CommandParameter="{Binding}"
                              IsVisible="{Binding IsRemoteType}"
                              ToolTip.Tip="{DynamicResource Profiles.Button.Update}">
                        <PathIcon Width="14" Height="14"
                                  Data="{StaticResource RefreshIconGeometry}"/>
                      </Button>
                      <Button Classes="iconButton"
                              Command="{Binding $parent[ItemsControl].((vm:ProfilesViewModel)DataContext).DeleteProfileCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding CanDelete}"
                              ToolTip.Tip="{DynamicResource Profiles.Button.Delete}">
                        <PathIcon Width="14" Height="14"
                                  Data="{StaticResource DeleteIconGeometry}"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Profile Form View -->
      <ScrollViewer Classes="smooth" IsVisible="{Binding IsProfileFormMode}">
        <StackPanel Margin="20" Spacing="8">

          <!-- Name -->
          <Border Classes="settingsItem">
            <Grid ColumnDefinitions="120,*" ColumnSpacing="16">
              <TextBlock Classes="settingsTitle"
                         Text="{DynamicResource Profiles.Form.NameLabel}"
                         VerticalAlignment="Center"/>
              <TextBox Grid.Column="1"
                       Text="{Binding NewProfileName}"
                       PlaceholderText="{DynamicResource Profiles.Form.NameWatermark}"/>
            </Grid>
          </Border>

          <!-- Type -->
          <Border Classes="settingsItem">
            <Grid ColumnDefinitions="120,*" ColumnSpacing="16">
              <TextBlock Classes="settingsTitle"
                         Text="{DynamicResource Profiles.Form.TypeLabel}"
                         VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding ProfileTypes}"
                        SelectedIndex="{Binding NewProfileType}"
                        IsEnabled="{Binding IsTypeEditable}"
                        HorizontalAlignment="Stretch"/>
            </Grid>
          </Border>

          <!-- Local Mode Selector -->
          <Border Classes="settingsItem"
                  IsVisible="{Binding ShowLocalFileModeSelector}">
            <Grid ColumnDefinitions="120,*" ColumnSpacing="16">
              <TextBlock Classes="settingsTitle"
                         Text="{DynamicResource Profiles.Form.FileLabel}"
                         VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding LocalModes}"
                        SelectedIndex="{Binding NewLocalMode}"
                        IsEnabled="{Binding IsLocalModeEditable}"
                        HorizontalAlignment="Stretch"/>
            </Grid>
          </Border>

          <!-- Local File Picker -->
          <Border Classes="settingsItem"
                  IsVisible="{Binding ShowLocalImportFilePicker}">
            <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="12">
              <TextBlock Classes="settingsTitle"
                         Text="{DynamicResource Profiles.Form.FileLabel}"
                         VerticalAlignment="Center"/>
              <TextBox Grid.Column="1"
                       Text="{Binding NewLocalFilePath}"
                       IsReadOnly="True"
                       PlaceholderText="{DynamicResource Profiles.Form.FileWatermark}"/>
              <Button Grid.Column="2"
                      Content="{DynamicResource Profiles.Form.BrowseButton}"
                      Command="{Binding BrowseLocalFileCommand}"
                      IsEnabled="{Binding IsLocalModeEditable}"/>
            </Grid>
          </Border>

          <!-- URL (remote only) -->
          <Border Classes="settingsItem"
                  IsVisible="{Binding IsRemoteProfile}">
            <Grid ColumnDefinitions="120,*" ColumnSpacing="16">
              <TextBlock Classes="settingsTitle"
                         Text="{DynamicResource Profiles.Form.UrlLabel}"
                         VerticalAlignment="Center"/>
              <TextBox Grid.Column="1"
                       Text="{Binding NewProfileUrl}"
                       PlaceholderText="{DynamicResource Profiles.Form.UrlWatermark}"/>
            </Grid>
          </Border>

          <!-- Auto Update / Interval (remote only) -->
          <Border Classes="settingsItem"
                  IsVisible="{Binding IsRemoteProfile}">
            <WrapPanel Orientation="Horizontal">
              <Grid ColumnDefinitions="120,Auto" ColumnSpacing="12" Margin="0,0,12,4">
                <TextBlock Classes="settingsTitle"
                           Text="{DynamicResource Profiles.Form.AutoUpdateLabel}"
                           VerticalAlignment="Center"/>
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding NewAutoUpdate}"
                              VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,100" ColumnSpacing="12" Margin="0,0,0,4">
                <TextBlock Classes="settingsTitle"
                           Text="{DynamicResource Profiles.Form.IntervalLabel}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding NewUpdateIntervalMinutes}"
                         PlaceholderText="{DynamicResource Profiles.Form.IntervalWatermark}"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"/>
              </Grid>
            </WrapPanel>
          </Border>

          <!-- Last Updated (edit mode) -->
          <Border Classes="settingsItem"
                  IsVisible="{Binding IsRemoteEditStatusVisible}">
            <Grid ColumnDefinitions="120,*" ColumnSpacing="16">
              <TextBlock Classes="settingsTitle"
                         Text="{DynamicResource Profiles.Form.LastUpdatedLabel}"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding EditLastUpdated}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
            </Grid>
          </Border>

          <!-- Content Actions -->
          <Border Classes="settingsItem"
                  IsVisible="{Binding ShowContentAction}">
            <Grid ColumnDefinitions="120,*" ColumnSpacing="16">
              <TextBlock Classes="settingsTitle"
                         Text="{DynamicResource Profiles.Form.ActionLabel}"
                         VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding ContentActionText}"
                        Command="{Binding ToggleContentEditorCommand}"/>
                <Button Content="{Binding OpenExternalText}"
                        Command="{Binding OpenInExternalEditorCommand}"
                        IsVisible="{Binding ShowExternalEditorAction}"/>
                <Button Content="{Binding CopyAsLocalText}"
                        IsVisible="{Binding IsRemoteProfile}"
                        Command="{Binding CopyAsLocalCommand}"/>
                <Button Content="{Binding UpdateConfigText}"
                        IsVisible="{Binding IsRemoteProfile}"
                        Command="{Binding UpdateEditingProfileCommand}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Inline Config Editor -->
          <Border Classes="settingsItem"
                  IsVisible="{Binding ShowInlineConfigEditor}"
                  Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Classes="settingsTitle"
                         Text="{DynamicResource Profiles.Form.ContentLabel}"/>
              <TextBox Text="{Binding ConfigContent}"
                       PlaceholderText="{DynamicResource Profiles.Form.ContentWatermark}"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       Height="260"
                       FontFamily="monospace"
                       FontSize="11"
                       IsReadOnly="{Binding IsConfigReadOnly}"/>
            </StackPanel>
          </Border>

          <!-- Status -->
          <TextBlock Text="{Binding NewProfileStatus}"
                     IsVisible="{Binding NewProfileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes="settingsDescription"
                     Margin="16,0"/>

          <!-- Progress -->
          <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding IsCreating}"
                       Height="4"/>

          <!-- Action Buttons -->
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource Profiles.Form.CreateButton}"
                    Command="{Binding CreateProfileCommand}"
                    Classes="accent"
                    IsEnabled="{Binding !IsCreating}"
                    IsVisible="{Binding IsCreatingMode}"/>
            <Button Content="{DynamicResource Profiles.Form.SaveButton}"
                    Command="{Binding SaveProfileCommand}"
                    Classes="accent"
                    IsEnabled="{Binding CanSaveProfile}"
                    IsVisible="{Binding IsEditingMode}"/>
            <Button Content="{DynamicResource Profiles.Form.CancelButton}"
                    Command="{Binding CancelCreateCommand}"
                    IsEnabled="{Binding !IsCreating}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- JSON Editor Fullscreen Overlay -->
      <Grid IsVisible="{Binding ShowConfigFullscreenView}"
            Background="{DynamicResource CartonControlBackgroundChromeMediumLowBrush}"
            Panel.ZIndex="10">
        <Grid Margin="20,12,20,20">
          <Border x:Name="ConfigEditorHost"
                  Background="{DynamicResource CartonSettingsItemBackgroundBrush}"
                  CornerRadius="8"
                  SizeChanged="OnConfigEditorHostSizeChanged"
                  ClipToBounds="True">
            <controls:JsonConfigEditor HorizontalAlignment="Stretch"
                                       x:Name="ConfigEditor"
                                       VerticalAlignment="Stretch"
                                       Document="{Binding ConfigDocument}"
                                       IsReadOnly="{Binding IsConfigReadOnly}"/>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>

</UserControl>

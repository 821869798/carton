<UserControl x:Name="GroupsViewRoot"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:carton.ViewModels"
             xmlns:helpers="using:carton.GUI.Helpers"
             xmlns:controls="using:carton.GUI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600"
             x:Class="carton.Views.Pages.GroupsView"
             x:DataType="vm:GroupsViewModel">

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource CartonControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource CartonControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{DynamicResource Navigation.Groups}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <ProgressBar Width="80"
                     Height="4"
                     IsVisible="{Binding IsLoading}"
                     IsIndeterminate="True"
                     VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1"
                  IsVisible="{Binding !ShowEmptyState}"
                  Background="{DynamicResource CartonControlBackgroundChromeMediumLowBrush}">
      <ItemsControl Margin="16,8,16,12"
                    ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:GroupItemViewModel">
            <Border Margin="0,0,0,6"
                    Padding="14,10"
                    CornerRadius="12"
                    BorderThickness="1"
                    VerticalAlignment="Top"
                    PointerPressed="OnGroupItemPressed"
                    Classes.expanded="{Binding IsExpanded}">
              <Border.Styles>
                <Style Selector="Border">
                  <Setter Property="Background" Value="{DynamicResource CartonControlBackgroundAltHighBrush}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource CartonSettingsItemBorderBrush}"/>
                </Style>
                <Style Selector="Border.expanded">
                  <Setter Property="Background" Value="{DynamicResource CartonControlBackgroundChromeHighBrush}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource CartonAccentBorderBrush}"/>
                </Style>
              </Border.Styles>

              <Grid RowDefinitions="Auto,Auto"
                    VerticalAlignment="Top"
                    RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      Background="Transparent"
                      ColumnSpacing="8">
                  <StackPanel Grid.Column="0"
                              Spacing="6">
                    <WrapPanel Orientation="Horizontal"
                               VerticalAlignment="Center"
                               ItemSpacing="6"
                               LineSpacing="6">
                      <TextBlock helpers:EmojiTextHelper.Text="{Binding Name}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                      <Border Padding="7,1"
                              CornerRadius="999"
                              Background="{DynamicResource CartonControlBackgroundChromeMediumBrush}">
                        <TextBlock Text="{Binding Type}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
                      </Border>
                      <Border Padding="7,1"
                              CornerRadius="999"
                              Background="{DynamicResource CartonControlBackgroundChromeMediumBrush}">
                        <TextBlock Text="{Binding ItemCount}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
                      </Border>
                    </WrapPanel>

                    <TextBlock helpers:EmojiTextHelper.Prefix="{DynamicResource Groups.Label.Current}"
                               helpers:EmojiTextHelper.Text="{Binding SelectedOutbound}"
                               FontSize="12"
                               Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
                  </StackPanel>

                  <Border Grid.Column="1"
                          VerticalAlignment="Top"
                          Padding="8,4"
                          CornerRadius="8"
                          Cursor="Hand"
                          PointerPressed="OnGroupTestDelayPressed">
                    <Border.Styles>
                      <Style Selector="Border">
                        <Setter Property="Background" Value="Transparent"/>
                      </Style>
                      <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="{DynamicResource CartonControlBackgroundBaseLowBrush}"/>
                      </Style>
                    </Border.Styles>
                    <Grid MinWidth="28"
                          Height="16"
                          VerticalAlignment="Center">
                      <!-- Spinning arc while this group's test is in flight. The animation is
                           keyed on the class, not just IsVisible: a style animation runs from
                           the moment its selector matches, so an always-present animation would
                           keep the whole page's compositor busy even while idle. -->
                      <Path Width="13"
                            Height="13"
                            IsVisible="{Binding IsTesting}"
                            Classes.testing="{Binding IsTesting}"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="50%,50%"
                            Stroke="{DynamicResource CartonControlForegroundBaseMediumBrush}"
                            StrokeThickness="2.4"
                            StrokeLineCap="Round"
                            Data="M 12 3 A 9 9 0 1 1 3 12">
                        <Path.RenderTransform>
                          <RotateTransform/>
                        </Path.RenderTransform>
                        <Path.Styles>
                          <Style Selector="Path.testing">
                            <Style.Animations>
                              <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                                <KeyFrame Cue="0%">
                                  <Setter Property="RotateTransform.Angle" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="RotateTransform.Angle" Value="360"/>
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </Path.Styles>
                      </Path>
                      <Path Width="14"
                            Height="14"
                            IsVisible="{Binding !IsTesting}"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="1,0,0,0"
                            Fill="{DynamicResource CartonControlForegroundBaseMediumBrush}"
                            Data="M13 2L5 13H11L10 22L18 11H12L13 2Z"/>
                    </Grid>
                  </Border>

                  <Grid Grid.Column="2"
                        Width="32"
                        Height="28"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False">
                    <Grid IsVisible="{Binding IsCollapsed}"
                          Width="32"
                          Height="28"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                      <Path Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource CartonControlForegroundBaseHighBrush}"
                            StrokeThickness="1.8"
                            StrokeLineCap="Round"
                            Data="M 5 3.5 L 9.5 7 L 5 10.5"/>
                    </Grid>
                    <Grid IsVisible="{Binding IsExpanded}"
                          Width="32"
                          Height="28"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                      <Path Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource CartonControlForegroundBaseHighBrush}"
                            StrokeThickness="1.8"
                            StrokeLineCap="Round"
                            Data="M 3.5 5 L 7 9.5 L 10.5 5"/>
                    </Grid>
                  </Grid>
                </Grid>

                <StackPanel Grid.Row="1"
                            IsVisible="{Binding IsCollapsed}"
                            Spacing="6">
                  <ItemsControl ItemsSource="{Binding CollapsedPreviewItems}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="5"
                                   LineSpacing="5"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:OutboundCacheSnapshot">
                        <Grid Width="12"
                              Height="12"
                              ToolTip.Tip="{Binding Tag}">
                          <Border CornerRadius="2"
                                  Background="{Binding Delay, Converter={StaticResource LatencyForegroundConverter}}"/>
                          <Border Width="5"
                                  Height="5"
                                  Background="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsSelected}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <ListBox x:Name="ExpandedProxiesList"
                         Grid.Row="1"
                         Margin="0,0,0,-4"
                         VerticalAlignment="Top"
                         MaxHeight="420"
                         BorderThickness="0"
                         Padding="0"
                         Background="Transparent"
                         SelectionMode="Single"
                         SizeChanged="OnExpandedProxiesListSizeChanged"
                         IsVisible="{Binding IsExpanded}"
                         ItemsSource="{Binding ItemRows}">
                  <ListBox.Styles>
                    <Style Selector="ListBox#ExpandedProxiesList > ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderBrush" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                      <Setter Property="Template">
                        <ControlTemplate>
                          <ContentPresenter Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </ControlTemplate>
                      </Setter>
                    </Style>
                    <Style Selector="ListBox#ExpandedProxiesList > ListBoxItem:pointerover">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBox#ExpandedProxiesList > ListBoxItem:selected">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:OutboundItemRowViewModel">
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:OutboundItemViewModel">
                            <controls:ProxyItemControl Width="{Binding ElementName=ExpandedProxiesList, Path=Bounds.Width, Converter={StaticResource ResponsiveItemWidthConverter}, ConverterParameter=16}"
                                                       Margin="0,5,0,5"
                                                       HorizontalAlignment="Stretch"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Empty state: the kernel is not up yet (or was stopped), versus up but the
         loaded profile has no outbound groups. Centred icon + explanation only; the
         kernel itself is started from the sidebar toggle, so this page owns no
         second start path. -->
    <StackPanel Grid.Row="1"
                IsVisible="{Binding ShowEmptyState}"
                MaxWidth="320"
                Spacing="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <Border Width="56"
              Height="56"
              CornerRadius="16"
              HorizontalAlignment="Center"
              Background="{DynamicResource CartonControlBackgroundBaseLowBrush}">
        <PathIcon Width="24"
                  Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource CartonControlForegroundBaseMediumLowBrush}"
                  Data="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42A6.92 6.92 0 0 1 19 12c0 3.87-3.13 7-7 7A6.995 6.995 0 0 1 7.58 6.58L6.17 5.17A8.932 8.932 0 0 0 3 12a9 9 0 0 0 18 0c0-2.74-1.23-5.18-3.17-6.83z"/>
      </Border>

      <TextBlock IsVisible="{Binding ShowKernelStoppedState}"
                 Text="{DynamicResource Groups.Empty.KernelStopped.Title}"
                 FontSize="15"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"/>
      <TextBlock IsVisible="{Binding ShowKernelStoppedState}"
                 Text="{DynamicResource Groups.Empty.KernelStopped.Description}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>

      <TextBlock IsVisible="{Binding ShowNoGroupsState}"
                 Text="{DynamicResource Groups.Empty.NoGroups.Title}"
                 FontSize="15"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"/>
      <TextBlock IsVisible="{Binding ShowNoGroupsState}"
                 Text="{DynamicResource Groups.Empty.NoGroups.Description}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Foreground="{DynamicResource CartonControlForegroundBaseMediumBrush}"/>
    </StackPanel>
  </Grid>

</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Themes.Fluent2" Version="12.2.999-cibuild0101023-alpha" />
    <PackageReference Include="Avalonia.Headless" Version="12.2.999-cibuild0101023-alpha" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.71.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- KernelLogCleaner is NOT linked here: it is public in the referenced carton.Core
         assembly, and linking it as source too made every use site ambiguous (CS0436,
         "type conflicts with the imported type"). Use the project reference instead. -->
    <Compile Include="..\carton.GUI\Services\CartonAccentPalette.cs" Link="Services\CartonAccentPalette.cs" />
    <Compile Include="..\carton.GUI\ViewModels\Pages\ConnectionsViewModel.cs" Link="Production\ConnectionsViewModel.cs" />
    <Compile Include="..\carton.GUI\ViewModels\ViewModelBase.cs" Link="Production\ViewModelBase.cs" />
    <Compile Include="..\carton.GUI\Models\NavigationPage.cs" Link="Production\NavigationPage.cs" />
    <Compile Include="..\carton.GUI\Resources\Localization\*.axaml.cs" Link="Production\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\carton.GUI\Resources\Localization\*.axaml" Link="Resources\Localization\%(Filename)%(Extension)" />
    <Compile Include="..\carton.GUI\Helpers\SmoothScrollBehavior.cs" Link="Production\SmoothScrollBehavior.cs" />
    <Compile Include="..\carton.GUI\Services\LocalizationService.cs" Link="Production\LocalizationService.cs" />
    <Compile Include="..\carton.GUI\Services\LogParser.cs" Link="Services\LogParser.cs" />
    <Compile Include="..\carton.GUI\Services\PackageManagedInstall.cs" Link="Services\PackageManagedInstall.cs" />
    <Compile Include="..\carton.GUI\Services\AppLaunchOptions.cs" Link="Services\AppLaunchOptions.cs" />
    <Compile Include="..\carton.GUI\Services\KernelCacheCleanupService.cs" Link="Services\KernelCacheCleanupService.cs" />
    <Compile Include="..\carton.GUI\Controls\JsonSyntax.cs" Link="Controls\JsonSyntax.cs" />
    <Compile Include="..\carton.GUI\Controls\JsonEditHistory.cs" Link="Controls\JsonEditHistory.cs" />
    <Compile Include="..\carton.GUI\ViewModels\Pages\DelayText.cs" Link="ViewModels\Pages\DelayText.cs" />
    <Compile Include="..\carton.GUI\ViewModels\Pages\TestingTagRefCounts.cs" Link="ViewModels\Pages\TestingTagRefCounts.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\carton.Core\carton.Core.csproj" />
  </ItemGroup>
</Project>

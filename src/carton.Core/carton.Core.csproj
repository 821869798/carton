<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyName>carton.Core</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="carton.GUI.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="obj\**\*.cs;bin\**\*.cs;obj-codex\**\*.cs" />
		<EmbeddedResource Remove="obj\**;bin\**;obj-codex\**" />
		<None Remove="obj\**;bin\**;obj-codex\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
		<PackageReference Include="Google.Protobuf" Version="3.36.1" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
		<PackageReference Include="Grpc.Tools" Version="2.84.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\started_service.proto" GrpcServices="Both" />
	</ItemGroup>
</Project>

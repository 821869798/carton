# Normalize text-file line endings on commit (LF in the repo); working tree keeps
# native endings. Prevents whole-file diff noise when editors rewrite CRLF<->LF.
* text=auto

# C# / XAML / docs
*.cs text
*.axaml text
*.csproj text
*.slnx text
*.md text diff=markdown
*.proto text
*.json text
*.yml text
*.sh text

# Shell scripts and packager metadata must stay LF even on Windows: CRLF turns
# `set -euo pipefail` into `pipefail\r` and the script dies ("invalid option name").
# Linux build scripts are routinely run from a Windows checkout through WSL.
*.sh text eol=lf
PKGBUILD text eol=lf
*.desktop text eol=lf

# Windows-specific
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
*.ttf binary
*.zip binary
*.7z binary
